

# This likelihood corresponds to the Planck 2018 high_l TT data (only high l temperature),
# marginalised over all nuisance parameters except A_planck.
# This is the emulated version, computed with a TensorFlow neural network in /model/.

# Grab the clik version of the Planck high_l_TT_lite likelihood:
# Planck_highl_TT_lite.path_clik = os.path.join(data.path['clik'], '../../../baseline/plc_3.0/hi_l/plik_lite/plik_lite_v22_TT.clik')

# List of spectra used
Planck_highl_TT_lite_emulated.spectrum_types = ['tt']

# List of required nuisance parameters
Planck_highl_TT_lite_emulated.use_nuisance = ['A_planck']
Planck_highl_TT_lite_emulated.A_planck_prior_center            = 1
Planck_highl_TT_lite_emulated.A_planck_prior_variance          = 0.0025